# Gradle outputs and local tooling caches (rebuildable).
.gradle/
build/
.tools/
# Isolated runtime directories; user saves are never cleanup candidates by rule alone.
run/
run-server/
run-village-checks/
# Editor and Python cache files.
.idea/
*.iml
__pycache__/

# Local playtest packages; ignore does not imply these versions are published.
release/*/*.jar
release/*/*.zip
release/*/*.mrpack
run-village-buildings-checks/

# Isolated loader/GameTest output, including numbered QA runs.
/run-*/
/logs/
/crash-reports/
/out/
/.cache/
/.vscode/
# Historical scratch restored locally from verified archives; maintained tools belong in tools/.
/work/

# Agent scratch copies; authoritative specifications and tooling are in docs/tools.
/.codex/

# Historical release binary copies belong in external archives / GitHub Releases,
# not source control. Preserve release notes and SHA manifests as text.
/release/*.jar
/release/*.zip
/release/*.mrpack

# Generated diagnostic outputs and large profiling dumps, including nested runs.
*.log
*.jfr
*.hprof
*.heapdump
*.tmp
*.bak
*.orig
*~
Thumbs.db
.DS_Store

# Local agent input / export workspace, not canonical project sources.
/.codex-input/
